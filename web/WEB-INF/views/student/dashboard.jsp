<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<div class="page-heading"><div><span class="eyebrow">MỖI NGÀY MỘT BƯỚC TIẾN</span><h1>Hôm nay em học gì?</h1><p>Tiếp tục bài học, thử sức và ôn lại điều chưa rõ.</p></div></div>
<div class="action-grid"><section class="surface action-hero"><span class="eyebrow">${done eq 0 ? 'BẮT ĐẦU HÀNH TRÌNH' : 'TIẾP TỤC HỌC'}</span><c:choose><c:when test="${not empty resumeItem}"><h2><c:out value="${resumeItem.title}"/></h2><p>Em đã hoàn thành ${done}/${total} bài trong lộ trình.</p><progress class="course-progress" value="${progress}" max="100" aria-label="Tiến độ lộ trình"></progress><p>${progress}% lộ trình · ${resumeItem.completed eq 1 ? 'Ôn lại kiến thức đã học' : 'Sẵn sàng cho bài tiếp theo'}</p><a class="btn btn-primary" href="${ctx}/student/lesson?id=${resumeItem.id}">${done eq 0 ? 'Bắt đầu từ Bài 1' : 'Tiếp tục học'} →</a></c:when><c:otherwise><h2>Bài học đang được chuẩn bị</h2><p>Em có thể xem lộ trình và quay lại khi giáo viên xuất bản bài học.</p><a href="${ctx}/courses">Xem lộ trình →</a></c:otherwise></c:choose></section>
<section class="surface"><h2>Việc nhỏ hôm nay</h2><c:forEach var="a" items="${unfinished}"><a class="resume-row" href="${ctx}/student/practice?id=${a.id}"><span><small>Luyện tập đang dở</small><br><c:out value="${a.title}"/></span><strong>Làm tiếp →</strong></a></c:forEach><c:if test="${empty unfinished}"><p>Em chưa có bài luyện đang dở. Học xong một bài rồi thử 5 câu trắc nghiệm nhé.</p></c:if><a class="resume-row" href="${ctx}/student/mistakes?course=${course.id}"><span>Sổ câu sai · ${fn:length(mistakes)} câu cần ôn</span><strong>Ôn lại →</strong></a><a href="${ctx}/student/progress">Xem tiến độ và điểm số →</a></section></div>
<section class="surface mt-4" data-notifications><h2>Thông báo bài tự luận</h2><div data-notification-list><c:if test="${empty notifications}"><p>Thông báo sẽ hiện tại đây khi bài tự luận được AI chấm xong.</p></c:if><c:forEach var="n" items="${notifications}"><a class="resume-row" href="${ctx}/student/review?id=${n.id}">Bài tự luận đã được AI nhận xét · <fmt:formatNumber value="${n.score}" maxFractionDigits="1"/>/10 →</a></c:forEach></div></section>
<section class="surface mt-4"><h2>Hỏi nhanh gia sư AI</h2><p>Mang theo bài đang học để gia sư gợi ý đúng phần em cần.</p><form action="${ctx}/student/tutor" method="get"><c:if test="${not empty resumeItem}"><input type="hidden" name="itemId" value="${resumeItem.id}"></c:if><label for="quick-question" class="form-label">Điều em chưa hiểu</label><textarea id="quick-question" class="form-control" name="question" rows="2" maxlength="3000" required placeholder="Em muốn hỏi về…"></textarea><button class="btn btn-outline-primary mt-3">Mở gia sư AI →</button></form></section>
<%@ include file="../partials/footer.jspf" %>
