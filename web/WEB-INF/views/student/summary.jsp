<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<div class="page-heading"><div><div class="eyebrow">${attempt.current_pos eq attempt.total ? 'ĐÃ NỘP BÀI' : 'ĐANG LUYỆN TẬP'}</div><h1><c:out value="${attempt.topic_title}"/></h1><p>Đã nộp ${attempt.current_pos} / ${attempt.total} câu. ${attempt.kind eq 'ESSAY' ? 'Điểm tự luận do AI đề xuất. Nếu bài cần sửa, em phải hoàn tất hướng dẫn và nộp ảnh làm lại.' : ''}</p></div><a class="btn btn-outline-primary" href="${ctx}/${teacherView ? 'admin/results' : 'student/history'}">Về lịch sử</a></div>
<c:set var="scoreSum" value="0"/><c:set var="gradedCount" value="0"/><c:set var="correctCount" value="0"/><c:forEach var="a" items="${answers}"><c:if test="${not empty a.score}"><c:set var="scoreSum" value="${scoreSum+a.score}"/><c:set var="gradedCount" value="${gradedCount+1}"/><c:if test="${a.score ge 10}"><c:set var="correctCount" value="${correctCount+1}"/></c:if></c:if></c:forEach>
<section class="surface mb-4"><h2>Kết quả lượt luyện tập</h2><c:choose><c:when test="${gradedCount eq attempt.total and attempt.current_pos eq attempt.total}"><p class="result-score"><fmt:formatNumber value="${scoreSum/attempt.total}" maxFractionDigits="1"/> / 10</p><c:if test="${attempt.kind eq 'MCQ'}"><p>${correctCount} câu đúng · ${attempt.total-correctCount} câu cần ôn.</p></c:if></c:when><c:otherwise><p>Chưa có điểm tổng kết. Đã chấm ${gradedCount}/${attempt.total} câu.</p></c:otherwise></c:choose><c:if test="${attempt.kind eq 'ESSAY'}"><p>Điểm tự luận do AI đề xuất, em hãy đối chiếu cùng giáo viên.</p></c:if></section><section class="surface"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Câu</th><th>Điểm / 10</th><th>Nhận xét</th><th></th></tr></thead><tbody><c:forEach var="answer" items="${answers}"><tr><td>${answer.position+1}</td><td><c:choose><c:when test="${empty answer.score}"><span class="pill">Chưa chấm</span></c:when><c:otherwise><fmt:formatNumber value="${answer.score}" maxFractionDigits="1"/></c:otherwise></c:choose></td><td><c:out value="${fn:substring(answer.feedback,0,120)}"/><c:if test="${answer.tutoring_phase eq 'WAITING'}"><div class="pill">Đang luyện từng bước</div></c:if><c:if test="${answer.tutoring_phase eq 'RESUBMIT'}"><div class="pill">Phải nộp ảnh làm lại</div></c:if></td><td><a href="${ctx}/${teacherView ? 'review' : 'student/review'}?id=${answer.id}">Xem lại →</a><c:if test="${not teacherView}"><br><a href="${ctx}/student/review?id=${answer.id}#tutor-chat">Hỏi AI về câu này</a></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty answers}"><p>Chưa nộp câu trả lời nào.</p></c:if></section><c:if test="${not teacherView}"><c:choose><c:when test="${not empty attempt.course_item_id}"><a class="btn btn-primary mt-4" href="${ctx}/student/lesson?id=${attempt.course_item_id}#review">Về bài học →</a></c:when><c:when test="${not empty attempt.course_id}"><a class="btn btn-primary mt-4" href="${ctx}/course?id=${attempt.course_id}">Về chương trình học →</a></c:when><c:otherwise><a class="btn btn-primary mt-4" href="${ctx}/courses">Chọn bài học →</a></c:otherwise></c:choose></c:if>

<%@ include file="../partials/footer.jspf" %>