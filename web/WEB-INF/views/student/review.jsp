<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<div class="page-heading"><div><div class="eyebrow">NHÌN LẠI CÂU TRẢ LỜI</div><h1>${empty answer.score ? 'Bài làm đã được lưu' : answer.score ge 10 ? 'Em đã làm tốt!' : 'Cùng tìm hiểu thêm nhé'}</h1><p><c:out value="${answer.topic_title}"/> <c:if test="${teacherView}">· <c:out value="${answer.full_name}"/></c:if></p></div><span class="score-badge"><c:choose><c:when test="${empty answer.score}"><small>Chưa chấm</small></c:when><c:otherwise><fmt:formatNumber value="${answer.score}" maxFractionDigits="1"/> <small>/ 10</small></c:otherwise></c:choose></span></div>
<div class="row g-4"><div class="col-lg-6"><section class="surface"><h2 class="question-prompt"><c:out value="${question.prompt}"/></h2><c:if test="${question.kind eq 'MCQ'}"><ul class="review-options"><li>A. <c:out value="${question.optionA}"/></li><li>B. <c:out value="${question.optionB}"/></li><li>C. <c:out value="${question.optionC}"/></li><li>D. <c:out value="${question.optionD}"/></li></ul><p>Em đã chọn: <strong><c:out value="${answer.chosen}"/></strong></p></c:if><div class="feedback prose"><c:out value="${answer.feedback}"/></div><c:if test="${question.kind eq 'MCQ' and not teacherView and answer.score ge 10}"><details class="mt-3"><summary>Xem đáp án và giải thích</summary><p class="mt-3">Đáp án đúng: <strong><c:out value="${question.correctOption}"/></strong></p><p class="prose"><c:out value="${question.explanation}"/></p></details></c:if>
<c:if test="${question.kind eq 'ESSAY'}"><p class="small text-secondary mt-3">Điểm tự luận do AI đề xuất, không phải điểm giáo viên xác nhận.</p><details><summary>Nội dung AI đọc được từ ảnh</summary><p class="prose mt-3"><c:out value="${answer.transcript}"/></p></details><a href="${ctx}/upload?id=${answer.id}" target="_blank" rel="noopener">Xem ảnh bài làm ↗</a><c:if test="${empty answer.score and not teacherView and answer.grading_status ne 'MANUAL_REQUIRED'}"><form method="post" action="${ctx}/student/grade" class="mt-3" data-busy="AI đang xử lý…"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${answer.id}"><button class="btn btn-primary">${answer.grading_status eq 'PENDING' ? 'Nhận gợi ý AI' : 'Thử chấm lại bằng AI'}</button></form><p class="small text-secondary mt-2">Ảnh đã lưu trước khi gọi AI. Nếu AI lỗi, ảnh vẫn còn và không ghi điểm 0.</p></c:if><c:if test="${answer.grading_status eq 'MANUAL_REQUIRED'}"><div class="alert alert-warning mt-3">AI không đọc rõ bài. Hãy chụp ảnh rõ nét và dùng biểu mẫu bên cạnh để nộp lại. Ảnh cũ vẫn được giữ trong lịch sử.</div></c:if></c:if>
<c:if test="${teacherView}"><hr><h3>Hướng dẫn chấm</h3><p>Đáp án: <c:out value="${question.correctOption}"/></p><p class="prose"><c:out value="${question.explanation}"/></p></c:if></section>
<a class="btn btn-primary mt-4" href="${ctx}/${teacherView ? 'results' : 'student/practice'}?id=${answer.attempt_id}">${teacherView ? 'Về kết quả lượt làm' : answer.current_pos lt answer.total ? 'Tiếp tục câu sau →' : 'Xem kết quả lượt làm →'}</a></div><div class="col-lg-6"><c:choose><c:when test="${question.kind eq 'ESSAY'}"><%@ include file="../partials/essay-steps.jspf" %></c:when><c:when test="${not teacherView}"><%@ include file="../partials/chat.jspf" %></c:when></c:choose></div></div>

<%@ include file="../partials/footer.jspf" %>
