<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<div class="page-heading"><div><span class="eyebrow">HIỂU BẠN HƠN</span><h1>Hồ sơ học tập</h1><p>Thông tin tối thiểu để tổ chức không gian học của bạn.</p></div></div>
<div class="profile-layout"><section class="surface"><h2>Thông tin cá nhân</h2><form method="post"><%@ include file="../partials/csrf.jspf" %><label class="form-label" for="full_name">Họ và tên</label><input id="full_name" name="full_name" class="form-control mb-3" maxlength="100" value="${fn:escapeXml(profile.full_name)}" required><label class="form-label" for="email">Email đăng nhập</label><input id="email" class="form-control mb-3" value="${fn:escapeXml(profile.email)}" readonly><label class="form-label" for="grade">Khối lớp</label><select id="grade" name="grade" class="form-select mb-4"><c:forEach var="g" begin="6" end="12"><option value="${g}" ${profile.grade eq g ? 'selected' : ''}>Lớp ${g}</option></c:forEach></select><h3>Môn quan tâm</h3><p class="text-secondary small">Lưu môn em quan tâm trong hồ sơ cá nhân. Em có thể mở bài học ngay từ lộ trình.</p><div class="form-check-list"><c:forEach var="s" items="${subjects}"><label><input type="checkbox" name="subjects" value="${s.id}" ${s.followed eq 1 ? 'checked' : ''}> <c:out value="${s.name}"/> · Lớp ${s.grade}</label></c:forEach></div><button class="btn btn-primary mt-4">Lưu hồ sơ</button></form></section>
<section class="surface mt-4" id="password"><h2>Đổi mật khẩu</h2><p class="text-secondary">Sau khi đổi mật khẩu, bạn cần đăng nhập lại.</p><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="action" value="password"><label class="form-label" for="current_password">Mật khẩu hiện tại</label><input class="form-control mb-3" id="current_password" name="current_password" type="password" autocomplete="current-password" maxlength="128" required><label class="form-label" for="new_password">Mật khẩu mới (10–128 ký tự)</label><input class="form-control mb-3" id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required><label class="form-label" for="confirm_password">Nhập lại mật khẩu mới</label><input class="form-control mb-3" id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required><button class="btn btn-outline-primary">Đổi mật khẩu</button></form></section></div>
<%@ include file="../partials/footer.jspf" %>