<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<a href="${ctx}/student/learn?lesson=${topic.lesson_id}">← Quay lại bài học</a><div class="page-heading mt-4"><div><div class="eyebrow">CÙNG TÌM HIỂU</div><h1><c:out value="${topic.title}"/></h1><p><c:out value="${topic.description}"/></p></div></div>
<div class="row g-4"><div class="col-lg-8"><c:forEach var="lecture" items="${lectures}"><article class="surface mb-4"><span class="eyebrow">BÀI GIẢNG</span><h2><c:out value="${lecture.title}"/></h2><p class="text-secondary"><c:out value="${lecture.description}"/></p><c:if test="${not empty lecture.embed}"><div class="ratio ratio-16x9 mb-4"><iframe src="${fn:escapeXml(lecture.embed)}" title="Video: ${fn:escapeXml(lecture.title)}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></c:if><div class="prose"><c:out value="${lecture.body}"/></div><c:if test="${not empty lecture.source_url}"><p class="small mt-4"><a href="${fn:escapeXml(lecture.source_url)}" target="_blank" rel="noopener noreferrer">Tham khảo bài học trên Lời giải hay ↗</a></p></c:if><c:if test="${empty lecture.embed and not empty lecture.video_url}"><a class="d-inline-block mt-3" href="${fn:escapeXml(lecture.video_url)}" target="_blank" rel="noopener noreferrer">Xem tài liệu tham khảo ↗</a></c:if></article></c:forEach><c:if test="${empty lectures}"><section class="surface">Bài giảng đang được giáo viên bổ sung.</section></c:if></div>
<div class="col-lg-4"><section class="surface practice-choice"><span class="eyebrow">ĐẾN LƯỢT EM</span><h2>Thử sức với bài học</h2><p>Không sao nếu chưa đúng. Gia sư sẽ giúp em hiểu từng bước.</p><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="topic_id" value="${topic.id}"><input type="hidden" name="kind" value="MCQ"><h3>01 / Trắc nghiệm</h3><p class="small text-secondary">Tối đa 5 câu mỗi lượt · ${counts.mcq} câu trong kho</p><button class="btn btn-primary w-100" ${counts.mcq eq 0 ? 'disabled' : ''}>Bắt đầu luyện tập →</button></form><hr><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="topic_id" value="${topic.id}"><input type="hidden" name="kind" value="ESSAY"><h3>02 / Tự luận</h3><p class="small text-secondary">Viết bài, chụp ảnh và nhận gợi ý · ${counts.essay} câu trong kho</p><button class="btn btn-outline-primary w-100" ${counts.essay eq 0 ? 'disabled' : ''}>Luyện tự luận →</button></form></section></div></div>

<%@ include file="../partials/footer.jspf" %>