<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<a class="back-link" href="${ctx}/student/progress">← Tiến độ của em</a><div class="page-heading"><div><span class="eyebrow">ÔN LẠI ĐỂ HIỂU SÂU</span><h1>Sổ câu sai</h1><p>${fn:length(mistakes)} câu cần ôn. Làm lại đúng sẽ đưa câu ra khỏi sổ; lịch sử cũ vẫn được giữ.</p></div><c:if test="${not empty mistakes}"><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="course" value="${course.id}"><button class="btn btn-primary">Làm lại các câu sai →</button></form></c:if></div>
<c:forEach var="q" items="${mistakes}"><article class="surface mb-3"><span class="eyebrow"><c:out value="${q.title}"/></span><h2><c:out value="${q.prompt}"/></h2><p>Lần gần nhất em chọn: <strong><c:out value="${q.chosen}"/></strong></p><a href="${ctx}/student/review?id=${q.id}">Hỏi AI gợi ý từng bước →</a></article></c:forEach><c:if test="${empty mistakes}"><section class="surface empty-state"><h2>Chưa có câu cần ôn</h2><p>Em chưa làm sai câu nào, hoặc đã làm lại đúng các câu trong sổ.</p><a class="btn btn-primary" href="${ctx}/courses">Tiếp tục lộ trình học →</a></section></c:if>
