<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<div class="page-heading"><div><div class="eyebrow">MỖI NGÀY MỘT KHÁM PHÁ</div><h1>Bài học của em</h1><p>Chọn một bài học và cùng tìm hiểu câu chuyện phía sau.</p></div><span class="pill pill-gold">Lịch sử &amp; hơn thế nữa</span></div>
<section class="learning-banner"><div><span class="small-label">HIỂU QUÁ KHỨ, MỞ TƯƠNG LAI</span><h2>Lịch sử bắt đầu<br>từ một câu hỏi.</h2><p>Đọc bài, thử sức, rồi cùng gia sư tìm lời giải.</p><a href="${ctx}/student/tutor" class="btn btn-light">Hỏi gia sư AI <span>↗</span></a></div><img src="${ctx}/assets/history.svg" alt="Họa tiết trống đồng và núi sông Việt Nam"></section>
<div class="section-heading"><h2>${empty lesson ? 'Khám phá bài học' : 'Chủ đề trong bài'}</h2><form method="get" class="search-form"><label class="visually-hidden" for="subject">Môn học</label><select id="subject" class="form-select" name="subject"><option value="0">Tất cả môn học</option><c:forEach var="subject" items="${subjects}"><option value="${subject.id}" ${param.subject eq subject.id ? 'selected' : ''}><c:out value="${subject.label}"/></option></c:forEach></select><button class="btn btn-outline-secondary">Lọc</button></form></div>
<c:choose><c:when test="${not empty lesson}"><div class="mb-4"><a href="${ctx}/student/learn">← Tất cả bài học</a><h3 class="mt-3"><c:out value="${lesson.title}"/></h3><p class="text-secondary"><c:out value="${lesson.description}"/></p></div><div class="row g-4"><c:forEach var="topic" items="${topics}" varStatus="n"><div class="col-lg-6"><a class="lesson-card" href="${ctx}/student/topic?id=${topic.id}"><span class="lesson-number">${n.count lt 10 ? '0' : ''}${n.count}</span><span><h3><c:out value="${topic.title}"/></h3><p><c:out value="${topic.description}"/></p><small>${topic.lecture_count} bài giảng · ${topic.question_count} câu hỏi</small></span><span class="card-arrow">↗</span></a></div></c:forEach></div><c:if test="${empty topics}"><div class="surface empty-state">Bài học chưa có chủ đề. Em hãy quay lại sau.</div></c:if></c:when>
<c:otherwise><div class="row g-4"><c:forEach var="item" items="${lessons}" varStatus="n"><div class="col-lg-6"><a class="lesson-card" href="${ctx}/student/learn?lesson=${item.id}&amp;subject=${item.subject_id}"><span class="lesson-number">${n.count lt 10 ? '0' : ''}${n.count}</span><span><small class="small-label"><c:out value="${item.subject_name}"/> · LỚP ${item.grade}</small><h3><c:out value="${item.title}"/></h3><p><c:out value="${item.description}"/></p></span><span class="card-arrow">↗</span></a></div></c:forEach></div><c:if test="${empty lessons}"><div class="surface empty-state">Chưa có bài học cho lựa chọn này.</div></c:if></c:otherwise></c:choose>

<%@ include file="../partials/footer.jspf" %>