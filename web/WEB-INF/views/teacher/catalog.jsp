<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<div class="page-heading"><div><div class="eyebrow">${adminView and contentEntity ? 'GIÁM SÁT NỘI DUNG' : 'KHO NỘI DUNG'}</div><h1><c:out value="${entity.label}"/></h1><p>${adminView and contentEntity ? 'Quản trị viên giám sát, ẩn/gỡ nội dung vi phạm kèm lý do; giáo viên phụ trách soạn nội dung.' : 'Sắp xếp kiến thức để mỗi bài học dễ khám phá hơn.'}</p></div><c:if test="${entity.table eq 'questions' and sessionScope.user.role eq 'TEACHER'}"><a class="btn btn-primary" href="${ctx}/teacher/generate">✦ Sinh câu hỏi bằng AI</a></c:if></div>
<div class="row g-4"><div class="col-xl-7"><section class="surface"><form class="search-form mb-4" method="get"><input type="hidden" name="entity" value="${entity.table}"><input name="q" class="form-control" aria-label="Tìm nội dung" placeholder="Tìm theo nội dung hoặc tiêu đề" value="${fn:escapeXml(param.q)}"><button class="btn btn-outline-primary">Tìm</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nội dung</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="row" items="${rows}"><tr><td><small class="text-secondary">#${row.id}</small><div class="item-title"><c:out value="${row[entity.title]}"/></div><c:if test="${entity.table eq 'questions'}"><span class="pill">${row.kind eq 'MCQ' ? 'Trắc nghiệm' : 'Tự luận'}</span></c:if></td><td><div class="actions"><c:if test="${row.hidden}"><span class="pill" title="${fn:escapeXml(row.hidden_reason)}">Đã ẩn</span></c:if><c:if test="${adminView and contentEntity}"><form method="post" class="d-flex gap-1 align-items-start flex-wrap"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="entity" value="${entity.table}"><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="action" value="moderate"><input type="hidden" name="hidden" value="${row.hidden ? 0 : 1}"><c:if test="${not row.hidden}"><input name="reason" class="form-control form-control-sm" style="max-width:190px" maxlength="500" placeholder="Lý do ẩn (tối thiểu 10 ký tự)" required></c:if><button class="btn btn-sm ${row.hidden ? 'btn-outline-success' : 'btn-outline-warning'}">${row.hidden ? 'Hiện lại' : 'Ẩn nội dung'}</button></form></c:if><c:if test="${not (adminView and contentEntity)}"><a class="btn btn-sm btn-outline-primary" href="${ctx}${managementBase}/catalog?entity=${entity.table}&amp;edit=${row.id}">Sửa</a><form method="post" data-confirm="Xóa mục này khỏi kho nội dung?"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="entity" value="${entity.table}"><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="action" value="delete"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></c:if></div></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="2" class="empty-state">Chưa có nội dung phù hợp. Thêm nội dung bằng biểu mẫu bên cạnh.</td></tr></c:if></tbody></table></div><%@ include file="../partials/pager.jspf" %></section></div>
<div class="col-xl-5"><c:if test="${not (adminView and contentEntity)}"><section class="surface"><h2>${empty edit ? 'Thêm mới' : 'Chỉnh sửa'}</h2><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="entity" value="${entity.table}"><input type="hidden" name="id" value="${empty edit ? 0 : edit.id}"><input type="hidden" name="action" value="save">
<c:if test="${not empty entity.parent}"><label class="form-label" for="parent">Thuộc ${entity.parent eq 'subjects' ? 'môn học' : entity.parent eq 'lessons' ? 'bài học' : 'chủ đề'}</label><select id="parent" class="form-select mb-3" name="${entity.parentColumn}" required><option value="">— Chọn mục —</option><c:forEach var="parent" items="${parents}"><option value="${parent.id}" ${edit[entity.parentColumn] eq parent.id ? 'selected' : ''}>#${parent.id} · <c:out value="${parent.label}"/></option></c:forEach></select></c:if>
<c:if test="${entity.fields.contains('name')}"><label class="form-label" for="name">Tên môn học</label>
<input id="name" class="form-control mb-3" name="name" maxlength="255" required value="${fn:escapeXml(edit.name)}"></c:if>
<c:if test="${entity.fields.contains('grade')}"><label class="form-label" for="grade">Lớp</label>
<input id="grade" class="form-control mb-3" name="grade" type="number" min="6" max="12" required value="${empty edit ? 6 : edit.grade}"></c:if>
<c:if test="${entity.fields.contains('title')}"><label class="form-label" for="title">Tiêu đề</label>
<input id="title" class="form-control mb-3" name="title" maxlength="255" required value="${fn:escapeXml(edit.title)}"></c:if>
<c:if test="${entity.fields.contains('description')}"><label class="form-label" for="description">Mô tả</label>
<textarea id="description" name="description" class="form-control mb-3" rows="3" maxlength="2000" ><c:out value="${edit.description}"/></textarea></c:if>
<c:if test="${entity.fields.contains('body')}"><label class="form-label" for="body">Nội dung bài giảng</label>
<textarea id="body" name="body" class="form-control mb-3" rows="6" maxlength="30000" ><c:out value="${edit.body}"/></textarea></c:if>
<c:if test="${entity.fields.contains('video_url')}"><label class="form-label" for="video_url">Liên kết video hoặc tài liệu</label>
<input id="video_url" class="form-control mb-3" name="video_url" type="url" maxlength="2000"  value="${fn:escapeXml(edit.video_url)}"></c:if>
<c:if test="${entity.fields.contains('prompt')}"><label class="form-label" for="prompt">Nội dung câu hỏi</label>
<textarea id="prompt" name="prompt" class="form-control mb-3" rows="3" maxlength="4000" required><c:out value="${edit.prompt}"/></textarea></c:if>
<c:if test="${entity.fields.contains('kind')}"><label class="form-label" for="kind">Loại câu hỏi</label>
<select id="kind" class="form-select mb-3" name="kind"><option value="MCQ" ${edit.kind eq 'MCQ' ? 'selected' : ''}>Trắc nghiệm</option><option value="ESSAY" ${edit.kind eq 'ESSAY' ? 'selected' : ''}>Tự luận</option></select></c:if>
<c:if test="${entity.fields.contains('option_a')}"><label class="form-label" for="option_a">Đáp án A</label>
<input id="option_a" class="form-control mb-3" name="option_a" maxlength="1000"  value="${fn:escapeXml(edit.option_a)}"></c:if>
<c:if test="${entity.fields.contains('option_b')}"><label class="form-label" for="option_b">Đáp án B</label>
<input id="option_b" class="form-control mb-3" name="option_b" maxlength="1000"  value="${fn:escapeXml(edit.option_b)}"></c:if>
<c:if test="${entity.fields.contains('option_c')}"><label class="form-label" for="option_c">Đáp án C</label>
<input id="option_c" class="form-control mb-3" name="option_c" maxlength="1000"  value="${fn:escapeXml(edit.option_c)}"></c:if>
<c:if test="${entity.fields.contains('option_d')}"><label class="form-label" for="option_d">Đáp án D</label>
<input id="option_d" class="form-control mb-3" name="option_d" maxlength="1000"  value="${fn:escapeXml(edit.option_d)}"></c:if>
<c:if test="${entity.fields.contains('correct_option')}"><label class="form-label" for="correct_option">Đáp án đúng</label>
<select id="correct_option" class="form-select mb-3" name="correct_option"><option value="" ${edit.correct_option eq '' ? 'selected' : ''}>— Tự luận để trống —</option><option value="A" ${edit.correct_option eq 'A' ? 'selected' : ''}>A</option><option value="B" ${edit.correct_option eq 'B' ? 'selected' : ''}>B</option><option value="C" ${edit.correct_option eq 'C' ? 'selected' : ''}>C</option><option value="D" ${edit.correct_option eq 'D' ? 'selected' : ''}>D</option></select></c:if>
<c:if test="${entity.fields.contains('explanation')}"><label class="form-label" for="explanation">Giải thích / hướng dẫn chấm</label>
<textarea id="explanation" name="explanation" class="form-control mb-3" rows="6" maxlength="8000" required><c:out value="${edit.explanation}"/></textarea></c:if>
<c:if test="${entity.fields.contains('difficulty')}"><label class="form-label" for="difficulty">Độ khó</label>
<select id="difficulty" class="form-select mb-3" name="difficulty"><option value="EASY" ${edit.difficulty eq 'EASY' ? 'selected' : ''}>Dễ</option><option value="MEDIUM" ${edit.difficulty eq 'MEDIUM' ? 'selected' : ''}>Vừa</option><option value="HARD" ${edit.difficulty eq 'HARD' ? 'selected' : ''}>Khó</option></select></c:if>

<c:if test="${contentEntity and not adminView}"><label class="d-block mb-3"><input type="checkbox" name="library_visible" ${edit.library_visible ? 'checked' : ''}> Cho phép giáo viên khác sao chép nội dung này</label></c:if>
<p class="small text-secondary">Chia sẻ chỉ mở quyền tái sử dụng cho giáo viên, tách biệt với xuất bản cho học sinh. Nội dung đã được chương trình sử dụng sẽ tự động lưu thành phiên bản mới; bản cũ và lịch sử bài làm được giữ nguyên.</p>
<c:if test="${entity.table eq 'questions'}"><p class="form-text">Tự luận: để trống bốn lựa chọn và đáp án đúng; nhập hướng dẫn chấm. Trắc nghiệm: điền đủ bốn đáp án.</p></c:if><button class="btn btn-primary">Lưu nội dung</button> <a href="${ctx}${managementBase}/catalog?entity=${entity.table}">Hủy chỉnh sửa</a></form></section></c:if><c:if test="${adminView and contentEntity}"><section class="surface"><h2>Kiểm duyệt nội dung</h2><p class="text-secondary">Quản trị viên không trực tiếp soạn hoặc sửa nội dung. Chỉ ẩn nội dung vi phạm kèm lý do; thao tác được ghi nhật ký và nội dung đã ẩn sẽ không tự hiện lại khi giáo viên chỉnh sửa.</p><p class="small">Chọn <strong>Ẩn nội dung</strong> ở từng dòng bên cạnh để ghi lý do, hoặc <strong>Hiện lại</strong> để hoàn tác.</p></section></c:if></div></div>

<c:if test="${contentEntity and not adminView}"><section class="surface mt-4"><h2>Nội dung được chia sẻ</h2><p class="text-secondary">Sao chép thành bản riêng để chỉnh sửa. Bản gốc, quyền tác giả và lịch sử phiên bản của giáo viên khác không thay đổi.</p><c:forEach var="row" items="${shared}"><div class="resume-row"><div><strong><c:out value="${row[entity.title]}"/></strong><div class="small text-secondary">#${row.id} · tác giả #${row.created_by}</div></div><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="entity" value="${entity.table}"><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="action" value="copy"><button class="btn btn-sm btn-outline-primary">Sao chép bản riêng</button></form></div></c:forEach><c:if test="${empty shared}"><div class="empty-state">Chưa có nội dung nào được giáo viên khác chia sẻ.</div></c:if></section></c:if>

<%@ include file="../partials/footer.jspf" %>
