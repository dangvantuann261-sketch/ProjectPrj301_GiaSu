<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<div class="page-heading"><div><span class="eyebrow">THEO DÕI LỚP HỌC</span><h1>Tiến độ học tập</h1><p>${sessionScope.user.role eq 'ADMIN' ? 'Theo dõi học sinh theo từng chương trình.' : 'Theo dõi học sinh trong các chương trình bạn được phân công.'}</p></div><a class="btn btn-outline-primary" href="${ctx}${managementBase}/courses">Quản lý chương trình →</a></div>
<form class="surface progress-filters" method="get">
<div><label for="progress-course" class="form-label">Chương trình / lớp phụ trách</label><select id="progress-course" name="course" class="form-select"><option value="0">Tất cả chương trình được phân công</option><c:forEach var="course" items="${courses}"><option value="${course.id}" ${course.id eq selectedCourse ? 'selected' : ''}><c:out value="${course.title}"/></option></c:forEach></select></div>
<div><label for="progress-search" class="form-label">Tìm học sinh</label><input id="progress-search" name="q" class="form-control" maxlength="100" placeholder="Tên hoặc email" value="${fn:escapeXml(param.q)}"></div>
<div><label for="progress-learning" class="form-label">Tiến độ</label><select id="progress-learning" name="learning" class="form-select"><option value="ALL" ${selectedLearning eq 'ALL' ? 'selected' : ''}>Tất cả tiến độ</option><option value="NOT_STARTED" ${selectedLearning eq 'NOT_STARTED' ? 'selected' : ''}>Chưa bắt đầu</option><option value="IN_PROGRESS" ${selectedLearning eq 'IN_PROGRESS' ? 'selected' : ''}>Đang học</option><option value="COMPLETED" ${selectedLearning eq 'COMPLETED' ? 'selected' : ''}>Đã hoàn thành</option></select></div>

<div><label for="progress-sort" class="form-label">Sắp xếp</label><select id="progress-sort" name="sort" class="form-select"><option value="name" ${selectedSort eq 'name' ? 'selected' : ''}>Tên học sinh</option><option value="recent" ${selectedSort eq 'recent' ? 'selected' : ''}>Hoạt động gần nhất</option><option value="progress" ${selectedSort eq 'progress' ? 'selected' : ''}>Tiến độ cao nhất</option></select></div>
<div class="lesson-actions"><button class="btn btn-primary">Áp dụng</button><a href="${ctx}${managementBase}/progress">Xóa bộ lọc</a></div></form>
<div class="progress-stat-grid"><article><span>Hồ sơ học tập</span><strong>${summary.enrollment_count}</strong><small>Mỗi học sinh được tính riêng theo khóa.</small></article><article><span>Chưa bắt đầu</span><strong>${summary.not_started}</strong><small>Chưa có hoạt động trong khóa.</small></article><article><span>Đang học</span><strong>${summary.in_progress}</strong><small>Đã bắt đầu, còn bài bắt buộc.</small></article><article><span>Đã hoàn thành</span><strong>${summary.completed}</strong><small>Đã hoàn thành mọi bài bắt buộc.</small></article></div>
<section class="surface"><div class="progress-section-heading"><div><h2>Tiến độ từng học sinh</h2><p class="small text-secondary">Tỷ lệ = số bài bắt buộc đã hoàn thành / tổng bài bắt buộc. Mở bài chưa được tính là hoàn thành. Thời gian hiển thị theo Việt Nam.</p></div><span class="pill">${summary.enrollment_count} hồ sơ học tập</span></div>
<div class="table-responsive"><table class="table align-middle progress-table"><thead><tr><th>Học sinh</th><th>Chương trình</th><th>Tiến độ</th><th>Hoạt động gần nhất</th><th>Chi tiết</th></tr></thead><tbody>
<c:forEach var="row" items="${rows}"><tr><td><strong><c:out value="${row.full_name}"/></strong><small class="d-block text-secondary"><c:out value="${row.email}"/></small></td><td><c:out value="${row.course_title}"/><c:if test="${row.course_status eq 'ARCHIVED'}"><small class="d-block text-secondary">Chương trình đã lưu trữ</small></c:if></td><td><div class="progress-cell"><div class="progress-caption"><strong>${row.percent_complete}%</strong><span>${row.required_done}/${row.required_count} bài</span></div><progress class="course-progress" max="100" value="${row.percent_complete}" aria-label="Tiến độ bài bắt buộc"></progress><span class="learning-state ${row.learning_status eq 'COMPLETED' ? 'is-complete' : row.learning_status eq 'IN_PROGRESS' ? 'is-learning' : ''}">${row.learning_status eq 'COMPLETED' ? 'Đã hoàn thành' : row.learning_status eq 'IN_PROGRESS' ? 'Đang học' : 'Chưa bắt đầu'}</span><c:if test="${row.required_count eq 0}"><small class="d-block text-secondary">Chưa có bài bắt buộc</small></c:if></div></td><td><c:choose><c:when test="${empty row.last_activity_local}"><span class="text-secondary">Chưa có hoạt động</span></c:when><c:otherwise><c:out value="${row.last_activity_local_text}"/></c:otherwise></c:choose></td><td><a class="btn btn-sm btn-outline-primary" href="${ctx}${managementBase}/progress?enrollment=${row.enrollment_id}">Xem lịch sử →</a></td></tr></c:forEach>
<c:if test="${empty rows}"><tr><td colspan="5" class="empty-state"><h3>Chưa có học sinh phù hợp</h3><p>${empty courses ? 'Bạn chưa được phân công chương trình nào. Admin có thể phân công tại Quản lý chương trình.' : 'Thử thay đổi bộ lọc hoặc kiểm tra trạng thái hồ sơ học tập của chương trình.'}</p></td></tr></c:if>
</tbody></table></div>
<%@ include file="../partials/progress-pager.jspf" %></section>
<%@ include file="../partials/footer.jspf" %>
