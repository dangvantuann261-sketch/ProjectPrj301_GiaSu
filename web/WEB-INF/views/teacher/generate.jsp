<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<div class="page-heading"><div><div class="eyebrow">TRỢ LÝ SOẠN BÀI</div><h1>Soạn câu hỏi với AI <span class="spark">✦</span></h1><p>AI đề xuất, thầy cô quyết định. Chỉ câu hỏi được duyệt mới vào ngân hàng.</p></div></div>
<section class="surface mb-4"><form method="post" data-busy="Đang soạn câu hỏi…"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="action" value="generate"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="topic">Chủ đề</label><select id="topic" name="topic_id" class="form-select" required><c:forEach var="topic" items="${topics}"><option value="${topic.id}">#${topic.id} · <c:out value="${topic.label}"/></option></c:forEach></select></div><div class="col-md-3"><label class="form-label" for="kind">Loại câu hỏi</label><select id="kind" name="kind" class="form-select"><option value="MCQ">Trắc nghiệm</option><option value="ESSAY">Tự luận</option></select></div><div class="col-md-3"><label class="form-label" for="count">Số lượng</label><input class="form-control" id="count" name="count" type="number" min="1" max="10" value="3" required></div></div><button class="btn btn-primary mt-3" ${empty topics ? 'disabled' : ''}>✦ Sinh bản nháp</button><c:if test="${empty topics}"><p>Hãy thêm chủ đề trước khi sinh câu hỏi.</p></c:if></form></section>
<c:if test="${not empty sessionScope.drafts}"><h2>Xem trước &amp; duyệt</h2><p class="text-secondary">Kiểm tra độ chính xác, sửa nội dung và bỏ chọn các câu chưa phù hợp.</p><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="action" value="approve"><input type="hidden" name="draftToken" value="${sessionScope.draftToken}"><div class="row g-4"><c:forEach var="draft" items="${sessionScope.drafts}" varStatus="status"><div class="col-lg-6"><section class="surface"><div class="form-check mb-4"><input id="include_${status.index}" type="checkbox" class="form-check-input" name="include_${status.index}" checked><label class="form-check-label fw-bold" for="include_${status.index}">Duyệt câu ${status.count} · ${draft.kind eq 'MCQ' ? 'Trắc nghiệm' : 'Tự luận'}</label></div>
<label class="form-label" for="prompt_${status.index}">Nội dung câu hỏi</label><textarea id="prompt_${status.index}" class="form-control mb-3" name="prompt_${status.index}" rows="3" required><c:out value="${draft.prompt}"/></textarea><label class="form-label" for="option_a_${status.index}">Đáp án A</label><input id="option_a_${status.index}" class="form-control mb-3" name="option_a_${status.index}" value="${fn:escapeXml(draft.optionA)}"><label class="form-label" for="option_b_${status.index}">Đáp án B</label><input id="option_b_${status.index}" class="form-control mb-3" name="option_b_${status.index}" value="${fn:escapeXml(draft.optionB)}"><label class="form-label" for="option_c_${status.index}">Đáp án C</label><input id="option_c_${status.index}" class="form-control mb-3" name="option_c_${status.index}" value="${fn:escapeXml(draft.optionC)}"><label class="form-label" for="option_d_${status.index}">Đáp án D</label><input id="option_d_${status.index}" class="form-control mb-3" name="option_d_${status.index}" value="${fn:escapeXml(draft.optionD)}"><label class="form-label" for="correct_option_${status.index}">Đáp án đúng</label><input id="correct_option_${status.index}" class="form-control mb-3" name="correct_option_${status.index}" value="${fn:escapeXml(draft.correctOption)}"><label class="form-label" for="explanation_${status.index}">Giải thích / hướng dẫn chấm</label><textarea id="explanation_${status.index}" class="form-control mb-3" name="explanation_${status.index}" rows="3" required><c:out value="${draft.explanation}"/></textarea><label class="form-label" for="difficulty_${status.index}">Độ khó</label><select class="form-select mb-3" id="difficulty_${status.index}" name="difficulty_${status.index}"><option value="EASY" ${draft.difficulty eq 'EASY' ? 'selected' : ''}>Dễ</option><option value="MEDIUM" ${draft.difficulty eq 'MEDIUM' ? 'selected' : ''}>Vừa</option><option value="HARD" ${draft.difficulty eq 'HARD' ? 'selected' : ''}>Khó</option></select>
</section></div></c:forEach></div><button class="btn btn-primary my-4">Duyệt &amp; lưu các câu đã chọn</button></form><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="action" value="discard"><button class="btn btn-outline-secondary">Bỏ bản nháp</button></form></c:if>

<%@ include file="../partials/footer.jspf" %>