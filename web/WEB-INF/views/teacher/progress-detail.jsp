<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<a class="back-link" href="${ctx}${managementBase}/progress?course=${learner.course_id}&amp;status=ALL">← Danh sách học sinh</a>
<div class="page-heading"><div><span class="eyebrow">LỊCH SỬ HỌC TẬP</span><h1><c:out value="${learner.full_name}"/></h1><p><c:out value="${learner.email}"/> · <c:out value="${learner.course_title}"/></p></div><span class="learning-state ${learner.learning_status eq 'COMPLETED' ? 'is-complete' : 'is-learning'}">${learner.learning_status eq 'COMPLETED' ? 'Đã hoàn thành' : learner.learning_status eq 'IN_PROGRESS' ? 'Đang học' : 'Chưa bắt đầu'}</span></div>
<section class="surface progress-overview"><div><span class="small-label">BÀI BẮT BUỘC</span><strong class="progress-total">${learner.percent_complete}%</strong><progress class="course-progress" max="100" value="${learner.percent_complete}" aria-label="Tiến độ học tập"></progress><p class="mt-2 mb-0">${learner.required_done} / ${learner.required_count} bài bắt buộc hoàn thành</p></div><dl><dt>Bắt đầu học</dt><dd><c:out value="${learner.enrolled_local_text}"/></dd><dt>Hoạt động gần nhất</dt><dd><c:choose><c:when test="${empty learner.last_activity_local}">Chưa có hoạt động</c:when><c:otherwise><c:out value="${learner.last_activity_local_text}"/></c:otherwise></c:choose></dd><c:if test="${not empty learner.completed_local}"><dt>Hoàn thành chương trình</dt><dd><c:out value="${learner.completed_local_text}"/></dd></c:if></dl></section>
<section class="surface mt-4"><h2>Tiến độ theo chương</h2><div class="chapter-progress-grid"><c:forEach var="chapter" items="${chapters}"><article><h3><c:out value="${chapter.title}"/></h3><div class="progress-caption"><span>${chapter.done}/${chapter.total} bài bắt buộc</span><strong>${chapter.progress}%</strong></div><progress class="course-progress" max="100" value="${chapter.progress}" aria-label="Tiến độ chương"></progress><p class="mt-2">Đã luyện ${chapter.practiced}/${fn:length(chapter.items)} bài.</p><p>Ôn tập chương: ${empty chapter.practice_finished ? 0 : chapter.practice_finished} lượt hoàn tất<c:if test="${not empty chapter.best_score}"> · Điểm cao nhất <fmt:formatNumber value="${chapter.best_score}" maxFractionDigits="1"/>/10</c:if></p></article></c:forEach></div></section><section class="surface mt-4"><h2>Tiến độ theo bài học</h2><p class="small text-secondary">Hoàn thành được ghi nhận khi học sinh chọn “Đã học xong”. Các mốc thời gian theo giờ Việt Nam.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Bài học</th><th>Yêu cầu</th><th>Trạng thái</th><th>Truy cập gần nhất</th><th>Hoàn thành lúc</th><th>Luyện tập</th></tr></thead><tbody>
<c:forEach var="lesson" items="${lessons}"><tr><td><small class="d-block text-secondary"><c:out value="${lesson.section_title}"/></small><strong><c:out value="${lesson.title}"/></strong></td><td>${lesson.required ? 'Bắt buộc' : 'Mở rộng'}</td><td><span class="learning-state ${lesson.completed eq 1 ? 'is-complete' : lesson.viewed eq 1 ? 'is-learning' : ''}">${lesson.completed eq 1 ? 'Đã hoàn thành' : lesson.viewed eq 1 ? 'Đã truy cập' : 'Chưa bắt đầu'}</span></td><td><c:choose><c:when test="${empty lesson.viewed_local}">—</c:when><c:otherwise><c:out value="${lesson.viewed_local_text}"/></c:otherwise></c:choose></td><td><c:choose><c:when test="${not empty lesson.completed_local}"><c:out value="${lesson.completed_local_text}"/></c:when><c:when test="${lesson.completed eq 1}"><span class="small text-secondary">Dữ liệu cũ chưa ghi thời điểm</span></c:when><c:otherwise>—</c:otherwise></c:choose></td><td>${lesson.practice_finished}/${lesson.practice_attempts} lượt hoàn tất<c:if test="${not empty lesson.best_score}"><br>Điểm cao nhất <strong><fmt:formatNumber value="${lesson.best_score}" maxFractionDigits="1"/>/10</strong></c:if></td></tr></c:forEach>
<c:if test="${empty lessons}"><tr><td colspan="6" class="empty-state">Khóa học chưa có bài giảng.</td></tr></c:if></tbody></table></div></section>
<section class="surface mt-4"><h2>Nhật ký học tập</h2><p class="small text-secondary">Nhật ký được ghi từ khi tính năng được cập nhật. Các lần mở lại cùng bài trong 5 phút được gộp thành một lượt truy cập.</p>
<ol class="learning-timeline"><c:forEach var="event" items="${activity}"><li><span class="timeline-mark ${event.action eq 'COMPLETE' ? 'is-complete' : ''}" aria-hidden="true">${event.action eq 'COMPLETE' ? '✓' : '•'}</span><div><strong>${event.action eq 'COMPLETE' ? 'Hoàn thành bài học' : 'Truy cập bài học'}</strong><p><c:out value="${event.title}"/></p><small><c:out value="${event.section_title}"/> · <c:out value="${event.occurred_local_text}"/></small></div></li></c:forEach></ol>
<c:if test="${empty activity}"><div class="empty-state">Chưa có sự kiện mới. Tiến độ đã lưu trước đây vẫn hiển thị trong bảng bài học.</div></c:if><%@ include file="../partials/progress-pager.jspf" %></section>
<%@ include file="../partials/footer.jspf" %>
