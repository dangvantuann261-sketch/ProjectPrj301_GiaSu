<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<div class="page-heading"><div><span class="eyebrow">QUẢN TRỊ HỆ THỐNG</span><h1>Thống kê và báo cáo</h1><p>Tổng hợp dữ liệu học tập. Điểm tự luận là điểm AI đề xuất.</p></div><a class="btn btn-outline-primary" href="${ctx}/admin/results">Xem bài làm →</a></div>
<div class="stats-grid"><div class="stat-card"><span>Bài đã nộp</span><strong>${report.submissions}</strong></div><div class="stat-card"><span>Bài đã có điểm</span><strong>${report.graded}</strong></div><div class="stat-card"><span>Đang chờ AI</span><strong>${empty report.pending ? 0 : report.pending}</strong></div><div class="stat-card"><span>Điểm trung bình / 10</span><strong><c:choose><c:when test="${empty report.average_score}">—</c:when><c:otherwise><fmt:formatNumber value="${report.average_score}" maxFractionDigits="2"/></c:otherwise></c:choose></strong></div></div>
<section class="surface mt-4"><h2>Hoạt động theo môn</h2><div class="table-responsive"><table class="table"><thead><tr><th>Môn học</th><th>Lớp</th><th>Lượt luyện tập</th><th>Câu đã chấm</th><th>Điểm trung bình</th></tr></thead><tbody><c:forEach var="row" items="${subjects}"><tr><td><c:out value="${row.name}"/></td><td>${row.grade}</td><td>${row.attempts}</td><td>${row.graded}</td><td><fmt:formatNumber value="${row.average_score}" maxFractionDigits="2"/></td></tr></c:forEach></tbody></table></div></section>
<section class="surface mt-4"><h2>50 thay đổi nghiệp vụ gần nhất</h2><div class="table-responsive"><table class="table"><thead><tr><th>Thời điểm (UTC)</th><th>Người thực hiện</th><th>Thao tác</th><th>Mã dữ liệu</th></tr></thead><tbody><c:forEach var="row" items="${activity}"><tr><td><c:out value="${row.created_at}"/></td><td><c:out value="${row.full_name}"/></td><td><c:out value="${row.action}"/></td><td>${row.resource_id}</td></tr></c:forEach><c:if test="${empty activity}"><tr><td colspan="4">Chưa có thay đổi được ghi nhận.</td></tr></c:if></tbody></table></div></section>
<%@ include file="../partials/footer.jspf" %>
