<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<div class="page-heading"><div><div class="eyebrow">QUẢN TRỊ</div><h1>Tài khoản</h1><p>Giáo viên và học sinh trong hệ thống.</p></div></div><div class="row g-4"><div class="col-xl-8"><section class="surface">
<form class="search-form mb-4" method="get"><input class="form-control" name="q" aria-label="Tìm tài khoản" placeholder="Tìm tên hoặc email" value="${fn:escapeXml(param.q)}"><button class="btn btn-outline-primary">Tìm kiếm</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Họ tên / Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="row" items="${rows}"><tr><td><strong><c:out value="${row.full_name}"/></strong><small class="d-block text-secondary"><c:out value="${row.email}"/></small></td><td>${row.role eq 'TEACHER' ? 'Giáo viên' : 'Học sinh'}</td><td><span class="pill">${row.locked eq 1 ? 'Đã khóa' : 'Hoạt động'}</span></td><td><div class="actions"><a class="btn btn-sm btn-outline-primary" href="${ctx}/admin/users?edit=${row.id}">Sửa</a><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="action" value="lock"><input type="hidden" name="locked" value="${row.locked eq 1 ? 0 : 1}"><button class="btn btn-sm btn-outline-secondary">${row.locked eq 1 ? 'Mở khóa' : 'Khóa'}</button></form><form method="post" data-confirm="Xóa tài khoản này? Lịch sử bài làm vẫn được giữ."><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="action" value="delete"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="4" class="empty-state">Không có tài khoản phù hợp.</td></tr></c:if></tbody></table></div><%@ include file="../partials/pager.jspf" %></section></div>
<div class="col-xl-4"><section class="surface"><h2>${empty edit ? 'Thêm tài khoản' : 'Sửa tài khoản'}</h2><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${empty edit ? 0 : edit.id}"><label class="form-label" for="full_name">Họ và tên</label><input class="form-control mb-3" id="full_name" name="full_name" maxlength="100" required value="${fn:escapeXml(edit.full_name)}"><label class="form-label" for="email">Email</label><input id="email" class="form-control mb-3" name="email" type="email" required maxlength="254" value="${fn:escapeXml(edit.email)}"><label class="form-label" for="role">Vai trò</label><select id="role" name="role" class="form-select mb-3"><option value="STUDENT" ${edit.role eq 'STUDENT' ? 'selected' : ''}>Học sinh</option><option value="TEACHER" ${edit.role eq 'TEACHER' ? 'selected' : ''}>Giáo viên</option></select><label class="form-label" for="password">Mật khẩu ${empty edit ? '' : 'mới'}</label><div class="input-group mb-2"><input id="password" class="form-control" type="password" name="password" minlength="10" maxlength="128" autocomplete="new-password" ${empty edit ? 'required' : ''}><button class="btn btn-outline-secondary" type="button" data-password-toggle aria-controls="password" aria-pressed="false">Hiện</button></div><p class="form-text">${empty edit ? 'Tối thiểu 10 ký tự.' : 'Để trống nếu giữ mật khẩu hiện tại.'}</p><button class="btn btn-primary mt-2">Lưu tài khoản</button><c:if test="${not empty edit}"> <a href="${ctx}/admin/users">Hủy</a></c:if></form></section></div></div>

<%@ include file="../partials/footer.jspf" %>