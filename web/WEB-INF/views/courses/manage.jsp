<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<div class="page-heading"><div><span class="eyebrow">${sessionScope.user.role eq 'ADMIN' ? 'DỮ LIỆU NGHIỆP VỤ' : 'KHÔNG GIAN GIÁO VIÊN'}</span><h1>Quản lý chương trình</h1><p>Chuẩn bị lộ trình, sắp xếp chương và bài học và theo dõi tiến độ trong phạm vi được phân công.</p></div><a class="btn btn-primary" href="${ctx}${managementBase}/courses">+ Tạo chương trình</a></div>
<div class="manager-layout"><aside class="surface"><h2>${sessionScope.user.role eq 'ADMIN' ? 'Tất cả chương trình' : 'Chương trình phụ trách'}</h2><c:forEach var="row" items="${rows}"><a class="managed-course ${row.id eq course.id ? 'current' : ''}" href="${ctx}${managementBase}/courses?id=${row.id}"><strong><c:out value="${row.title}"/></strong><small>${row.status eq 'DRAFT' ? 'Bản nháp' : row.status eq 'PUBLISHED' ? 'Đã xuất bản' : 'Lưu trữ'} · ${row.item_count} bài</small></a></c:forEach><c:if test="${empty rows}"><p class="text-secondary">Chưa có khóa được phân công. Bạn có thể tạo bản nháp đầu tiên.</p></c:if></aside>
<div><section class="surface"><h2>${empty course ? 'Tạo lộ trình mới' : 'Thông tin chương trình'}</h2><c:if test="${not empty course}"><p><span class="pill">${course.status eq 'DRAFT' ? 'Bản nháp' : course.status eq 'PUBLISHED' ? 'Đã xuất bản' : 'Lưu trữ'}</span> <a href="${ctx}/course?id=${course.id}">Xem chi tiết ↗</a></p></c:if>
<c:if test="${not editable}"><div class="alert alert-info">Chương trình chỉ chỉnh sửa khi ở bản nháp và chưa có người học. Nội dung đã được người học sử dụng được giữ ổn định để bảo toàn tiến độ.</div></c:if>
<form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${empty course ? 0 : course.id}"><input type="hidden" name="action" value="save"><fieldset ${editable ? '' : 'disabled'}>
<label class="form-label" for="title">Tên chương trình</label><input id="title" name="title" class="form-control mb-3" maxlength="255" required value="${fn:escapeXml(course.title)}">
<div class="row g-3 mb-3"><div class="col-md-6"><label class="form-label" for="subject_id">Môn học</label><select id="subject_id" name="subject_id" class="form-select" required><c:forEach var="s" items="${subjects}"><option value="${s.id}" ${s.id eq course.subject_id ? 'selected' : ''}><c:out value="${s.label}"/></option></c:forEach></select></div><div class="col-md-6"><label class="form-label" for="duration">Thời lượng dự kiến (phút)</label><input id="duration" name="duration_minutes" type="number" min="1" max="100000" class="form-control" value="${empty course ? 60 : course.duration_minutes}" required></div></div>
<label class="form-label" for="summary">Giới thiệu ngắn</label><textarea id="summary" name="summary" class="form-control mb-3" rows="3" maxlength="2000" required><c:out value="${course.summary}"/></textarea>
<label class="form-label" for="objectives">Mục tiêu học tập</label><textarea id="objectives" name="objectives" class="form-control mb-3" rows="4" maxlength="4000" required><c:out value="${course.objectives}"/></textarea>
<label class="form-label" for="audience">Đối tượng phù hợp</label><textarea id="audience" name="audience" class="form-control mb-3" rows="2" maxlength="2000" required><c:out value="${course.audience}"/></textarea>
<label class="form-label" for="prerequisites">Kiến thức đầu vào</label><textarea id="prerequisites" name="prerequisites" class="form-control mb-3" rows="2" maxlength="2000"><c:out value="${course.prerequisites}"/></textarea>
<button class="btn btn-primary">Lưu bản nháp</button></fieldset></form></section>
<c:if test="${not empty course}"><section class="surface mt-4"><h2>Chương trình học</h2><p class="text-secondary">Tái sử dụng bài giảng cùng môn. Thứ tự phải duy nhất; dùng các số cách nhau để dễ sắp xếp.</p>
<c:forEach var="i" items="${items}"><div class="curriculum-editor"><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="action" value="item"><input type="hidden" name="item_id" value="${i.id}"><input type="hidden" name="lecture_id" value="${i.lecture_id}"><h3><c:out value="${i.title}"/></h3><fieldset ${curation ? '' : 'disabled'}><div class="row g-2"><div class="col-sm-8"><label class="form-label">Nhóm/chương<input name="section_title" maxlength="255" class="form-control" value="${fn:escapeXml(i.section_title)}"></label></div><div class="col-sm-4"><label class="form-label">Thứ tự<input name="position" type="number" min="1" max="10000" required class="form-control" value="${i.position}"></label></div></div><div class="lesson-actions"><label><input type="checkbox" name="required" ${i.required ? 'checked' : ''}> Bắt buộc</label><button class="btn btn-sm btn-outline-primary">Cập nhật</button></div></fieldset></form><c:if test="${curation}"><form method="post" class="mt-2" data-confirm="Bỏ bài giảng này khỏi chương trình?"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="item_id" value="${i.id}"><input type="hidden" name="action" value="remove"><button class="btn btn-sm btn-outline-danger">Bỏ khỏi khóa</button></form></c:if><c:if test="${curation and not empty itemQuestions[i.id]}"><details class="mt-2"><summary>Chọn câu hỏi luyện tập (${fn:length(itemQuestions[i.id])})</summary><form method="post" class="mt-2"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="item_id" value="${i.id}"><input type="hidden" name="action" value="questions"><c:forEach var="q" items="${itemQuestions[i.id]}"><label class="d-block small"><input type="checkbox" name="question_id" value="${q.id}" ${q.selected gt 0 ? 'checked' : ''}> <span class="pill">${q.kind eq 'MCQ' ? 'TN' : 'TL'}</span> <c:out value="${q.prompt}"/></label></c:forEach><button class="btn btn-sm btn-primary mt-2">Lưu câu hỏi cho bài</button></form></details></c:if><c:if test="${curation and empty itemQuestions[i.id]}"><p class="small text-secondary mt-2">Chưa có câu hỏi cùng chủ đề được chia sẻ cho bạn. Hãy soạn câu hỏi trong ngân hàng trước khi gắn vào bài.</p></c:if></div></c:forEach>
<c:if test="${empty items}"><div class="empty-state">Chưa có bài giảng trong chương trình.</div></c:if>
<c:if test="${curation}"><form method="post" class="mt-4"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="action" value="item"><label class="form-label" for="lecture_id">Thêm bài giảng có sẵn</label><select id="lecture_id" name="lecture_id" class="form-select mb-3" required><option value="">Chọn bài giảng</option><c:forEach var="l" items="${lectures}"><option value="${l.id}"><c:out value="${l.title}"/> · v${l.version}${l.superseded ? ' (bản cũ)' : ''}</option></c:forEach></select><div class="row g-3"><div class="col-sm-8"><label class="form-label" for="section">Nhóm/chương</label><input id="section" name="section_title" class="form-control" maxlength="255"></div><div class="col-sm-4"><label class="form-label" for="position">Thứ tự</label><input id="position" name="position" type="number" min="1" max="10000" value="${(fn:length(items)+1)*10}" class="form-control" required></div></div><div class="lesson-actions mt-3"><label><input type="checkbox" name="required" checked> Bắt buộc</label><button class="btn btn-primary">Thêm vào chương trình</button></div></form></c:if></section>
<section class="surface mt-4"><h2>Giáo viên và xuất bản</h2><c:forEach var="t" items="${teachers}"><div class="resume-row"><strong><c:out value="${t.full_name}"/></strong><c:if test="${sessionScope.user.role eq 'ADMIN'}"><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="action" value="teacher"><input type="hidden" name="teacher_id" value="${t.id}"><input type="hidden" name="remove" value="1"><button class="btn btn-sm btn-outline-danger">Bỏ phân công</button></form></c:if></div></c:forEach>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><form method="post" class="lesson-actions mt-3"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="action" value="teacher"><select class="form-select" name="teacher_id" aria-label="Chọn giáo viên" required><c:forEach var="t" items="${teacherChoices}"><option value="${t.id}"><c:out value="${t.full_name}"/></option></c:forEach></select><button class="btn btn-outline-primary">Phân công</button></form></c:if>
<form method="post" class="lesson-actions mt-4"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${course.id}"><input type="hidden" name="action" value="status"><select class="form-select" name="status" aria-label="Trạng thái khóa"><option value="DRAFT" ${course.status eq 'DRAFT' ? 'selected' : ''}>Bản nháp</option><option value="PUBLISHED" ${course.status eq 'PUBLISHED' ? 'selected' : ''}>Xuất bản</option><option value="ARCHIVED" ${course.status eq 'ARCHIVED' ? 'selected' : ''}>Lưu trữ — ngừng mở cho người học mới</option></select><button class="btn btn-primary">Đổi trạng thái</button></form><p class="small text-secondary mt-3">Giáo viên phụ trách được xuất bản chương trình của mình khi có ít nhất một bài bắt buộc đang hiển thị và giáo viên đang hoạt động. Học sinh đã học vẫn có thể ôn lại nội dung lưu trữ.</p></section>
<section class="surface mt-4"><h2>Theo dõi học sinh</h2><p>Xem tiến độ từng chương, từng bài và kết quả luyện tập của học sinh.</p><a class="btn btn-primary" href="${ctx}${managementBase}/progress?course=${course.id}">Xem tiến độ học tập →</a></section></c:if>
</div></div>
<%@ include file="../partials/footer.jspf" %>