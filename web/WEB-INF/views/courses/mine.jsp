<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<div class="page-heading"><div><span class="eyebrow">HÀNH TRÌNH HỌC TẬP</span><h1>${dashboard ? 'Hôm nay, học thêm một điều mới.' : 'Tiến độ của em'}</h1><p>Học theo chương, luyện theo bài, theo dõi từng bước tiến.</p></div><a class="btn btn-primary" href="${ctx}/courses">Chọn chương trình học →</a></div>
<div class="learner-stats"><article><span>Đang học</span><strong>${activeCount}</strong><small>Chương trình đang tiếp tục</small></article><article><span>Đã hoàn thành</span><strong>${completeCount}</strong><small>Đã học đủ bài bắt buộc</small></article><article><span>Luyện tập</span><strong>${fn:length(unfinished)}</strong><small>Lượt gần nhất đang làm dở</small></article></div>
<c:if test="${not empty unfinished}"><section class="surface mb-4"><h2>Tiếp tục luyện tập</h2><c:forEach var="a" items="${unfinished}"><a class="resume-row" href="${ctx}/student/practice?id=${a.id}"><span><c:out value="${a.title}"/></span><strong>Làm tiếp →</strong></a></c:forEach></section></c:if>
<div class="section-heading"><h2>Chương trình đã học</h2><span class="text-secondary">${fn:length(rows)} chương trình</span></div>
<div class="course-grid"><c:forEach var="c" items="${rows}"><article class="course-card"><div class="course-cover compact"><span class="cover-symbol">▤</span><p><c:out value="${c.subject_name}"/> · Lớp ${c.grade}</p></div><div class="course-card-body"><span class="pill">${c.progress eq 100 ? 'Đã hoàn thành lý thuyết' : 'Đang học'}</span><h3 class="mt-3"><c:out value="${c.title}"/></h3><div class="progress-caption"><span>${c.done}/${c.total} bài bắt buộc</span><strong>${c.progress}%</strong></div><progress class="course-progress" value="${c.progress}" max="100" aria-label="Tiến độ chương trình"></progress><a class="btn btn-primary w-100 mt-3" href="${ctx}/student/resume?id=${c.id}">Tiếp tục học →</a><a class="course-cta" href="${ctx}/course?id=${c.id}">Tiến độ từng chương và bài <span>→</span></a></div></article></c:forEach></div>
<c:if test="${empty rows}"><section class="surface empty-state"><div class="empty-icon">◎</div><h2>Bắt đầu từ bài học đầu tiên</h2><p>Chọn chương trình, mở một bài học để lưu tiến độ của em.</p><a class="btn btn-primary" href="${ctx}/courses">Xem chương và bài học</a></section></c:if>
<%@ include file="../partials/footer.jspf" %>
