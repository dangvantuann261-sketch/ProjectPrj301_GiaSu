<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>

<section class="course-heading"><div><span class="pill"><c:out value="${course.subject_name}"/> · Lớp ${course.grade}</span><h1>Lộ trình <c:out value="${course.title}"/></h1><p><c:out value="${course.summary}"/></p><div class="course-meta"><span>▤ ${fn:length(chapters)} chương</span><span>${fn:length(items)} bài học</span><span>Lý thuyết và luyện tập</span></div></div></section>
<section class="surface mb-4"><label for="lesson-search">Tìm bài học</label><input class="form-control" id="lesson-search" type="search" data-lesson-search placeholder="Tên bài hoặc chương…"><p class="small mt-2 mb-0" data-search-status role="status">Tìm trong ${fn:length(items)} bài học của lộ trình.</p></section><div class="learning-layout"><div>
<div class="section-heading"><h2>Chương và bài học</h2><span class="text-secondary">Chọn bài để bắt đầu</span></div>
<c:forEach var="chapter" items="${chapters}" varStatus="chapterIndex">
<details class="surface chapter-block" id="chapter-${chapter.anchor}" open>
<summary><span><span class="eyebrow">CHƯƠNG ${chapterIndex.count}</span><strong><c:out value="${chapter.title}"/></strong><small>${fn:length(chapter.items)} bài học · Đã học ${chapter.done}/${chapter.total} bài bắt buộc · Đã luyện ${chapter.practiced}/${fn:length(chapter.items)} bài</small></span><span class="pill">${chapter.progress}%</span></summary>
<progress class="course-progress" value="${chapter.progress}" max="100" aria-label="Tiến độ chương"></progress>
<div class="curriculum"><c:forEach var="i" items="${chapter.items}">
<div class="curriculum-row" data-lesson-row><span class="curriculum-number">${i.completed eq 1 ? '✓' : '○'}</span><div><h3><c:out value="${i.title}"/></h3><small class="text-secondary">${i.completed eq 1 ? 'Đã xong' : not empty i.last_viewed_at or i.practice_attempts gt 0 ? 'Đang học' : 'Chưa học'} · ${i.practice_finished gt 0 ? 'Đã luyện tập' : 'Chưa luyện tập'}<c:if test="${not empty i.best_score}"> · Điểm cao nhất <fmt:formatNumber value="${i.best_score}" maxFractionDigits="1"/>/10</c:if></small></div><div class="lesson-actions">
<a class="btn btn-sm btn-outline-primary" href="${ctx}/${sessionScope.user.role eq 'STUDENT' ? 'student/lesson' : 'preview'}?id=${i.id}">Lý thuyết</a>
<c:if test="${i.question_count gt 0 or i.essay_count gt 0}"><c:choose><c:when test="${sessionScope.user.role eq 'STUDENT'}"><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="item_id" value="${i.id}"><input type="hidden" name="scope" value="lesson"><input type="hidden" name="kind" value="${i.question_count gt 0 ? 'MCQ' : 'ESSAY'}"><button class="btn btn-sm btn-primary">Luyện tập</button></form></c:when><c:otherwise><a class="btn btn-sm btn-primary" href="${ctx}/login">Luyện tập</a></c:otherwise></c:choose></c:if>
</div></div></c:forEach></div>
<div class="chapter-review"><div><h3>Ôn tập chương</h3><p>Tổng hợp kiến thức các bài trong chương · tối đa 10 câu mỗi lượt.</p><c:if test="${chapter.practice_finished gt 0}"><small>Đã hoàn tất ${chapter.practice_finished} lượt<c:if test="${not empty chapter.best_score}"> · Điểm cao nhất <fmt:formatNumber value="${chapter.best_score}" maxFractionDigits="1"/>/10</c:if></small></c:if></div>
<c:if test="${chapter.question_count gt 0}"><c:choose><c:when test="${sessionScope.user.role eq 'STUDENT'}"><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="item_id" value="${chapter.anchor}"><input type="hidden" name="scope" value="chapter"><input type="hidden" name="kind" value="MCQ"><button class="btn btn-primary">Luyện tập chương →</button></form></c:when><c:otherwise><a class="btn btn-primary" href="${ctx}/login">Đăng nhập để luyện tập</a></c:otherwise></c:choose></c:if></div>
</details></c:forEach>
<c:if test="${empty chapters}"><section class="surface empty-state">Giáo viên đang chuẩn bị chương và bài học.</section></c:if>
</div><aside><section class="surface curriculum-panel"><span class="eyebrow">HÀNH TRÌNH HỌC TẬP</span><h2>Tiến độ của em</h2><div class="progress-caption"><span>Lý thuyết đã hoàn thành</span><strong>${progress}%</strong></div><progress class="course-progress" value="${progress}" max="100" aria-label="Tiến độ chương trình"></progress><p class="small text-secondary mt-3">Học lý thuyết, đánh dấu đã học, rồi luyện tập theo bài và ôn tập cuối chương. Điểm luyện tập được lưu riêng.</p>
<c:choose><c:when test="${empty sessionScope.user}"><a class="btn btn-primary w-100" href="${ctx}/login">Đăng nhập để lưu tiến độ</a></c:when><c:when test="${sessionScope.user.role eq 'STUDENT' and not empty items}"><a class="btn btn-primary w-100" href="${ctx}/student/resume?id=${course.id}">${empty enrollment ? 'Bắt đầu học →' : 'Tiếp tục học →'}</a></c:when><c:when test="${manager}"><a class="btn btn-outline-primary" href="${ctx}/${sessionScope.user.role eq 'ADMIN' ? 'admin' : 'teacher'}/courses?id=${course.id}">Quản lý chương trình</a></c:when></c:choose>
<hr><h3>Giáo viên phụ trách</h3><c:forEach var="t" items="${teachers}"><div class="teacher-line"><span class="avatar"><c:out value="${fn:substring(t.full_name,0,1)}"/></span><strong><c:out value="${t.full_name}"/></strong></div></c:forEach></section></aside></div>
<c:if test="${not empty timeline}"><section class="surface mt-4"><h2>Dòng thời gian sự kiện</h2><p>Một số mốc tiêu biểu trong lộ trình, sắp theo thứ tự thời gian.</p><ol class="timeline"><c:forEach var="e" items="${timeline}"><li><strong><c:out value="${e.time}"/></strong><c:out value="${e.title}"/> · <a href="${ctx}/preview?id=${e.item}">Xem bài học →</a></li></c:forEach></ol></section></c:if><%@ include file="../partials/footer.jspf" %>
