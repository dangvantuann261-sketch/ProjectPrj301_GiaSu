<%@ page pageEncoding="UTF-8" %>
<%@ include file="../partials/header.jspf" %>
<a class="back-link" href="${ctx}/course?id=${course.id}">← <c:out value="${course.title}"/></a>
<div class="page-heading"><div><span class="eyebrow">${preview ? 'LÝ THUYẾT BÀI HỌC' : 'TẬP TRUNG VÀO ĐIỀU BẠN ĐANG HỌC'}</span><h1><c:out value="${item.title}"/></h1></div><c:if test="${not preview}"><span class="pill">${record.completed ? '✓ Đã hoàn thành' : 'Đang học'}</span></c:if></div>
<div class="learning-layout"><div><article class="surface lecture-reader"><c:if test="${not empty item.embed}"><div class="ratio ratio-16x9 mb-4"><iframe src="${fn:escapeXml(item.embed)}" title="Video: ${fn:escapeXml(item.title)}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></c:if><div class="prose"><c:out value="${item.body}"/></div><c:if test="${not empty item.source_url}"><p class="small text-secondary mt-4">Nội dung tóm tắt và câu hỏi tự biên soạn theo bài trong SGK Kết nối tri thức. <a href="${fn:escapeXml(item.source_url)}" target="_blank" rel="noopener noreferrer">Tham khảo bài học trên Lời giải hay ↗</a></p></c:if><c:if test="${empty item.embed and not empty item.video_url}"><a class="btn btn-outline-primary mt-4" href="${fn:escapeXml(item.video_url)}" target="_blank" rel="noopener noreferrer">Xem tài liệu tham khảo ↗</a></c:if></article>
<c:choose><c:when test="${preview}"><div class="surface mt-4"><h3>Học và luyện tập theo từng bài</h3><p>Đăng nhập bằng tài khoản học sinh để lưu tiến độ và làm bài luyện tập.</p><a class="btn btn-primary" href="${ctx}/login">Đăng nhập để học</a></div></c:when><c:otherwise>
<section class="surface mt-4"><div class="lesson-actions"><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="action" value="complete"><button class="btn btn-primary" ${record.completed ? 'disabled' : ''}>${record.completed ? '✓ Đã học bài này' : 'Đánh dấu đã học'}</button></form><form method="post"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="action" value="bookmark"><button class="btn btn-outline-primary">${record.bookmarked ? '★ Bỏ lưu bài cần ôn' : '☆ Lưu bài cần ôn'}</button></form><a class="btn btn-outline-primary" href="${ctx}/student/tutor?itemId=${item.id}">Hỏi gia sư AI ↗</a></div><p class="small text-secondary mt-3 mb-0">Chỉ đánh dấu khi bạn đã học xong. Mở trang không tự động hoàn thành bài. Gia sư AI nhận ngữ cảnh bài học này; hội thoại được lưu để em tiếp tục lần sau.</p></section>
<section class="surface mt-4" id="review"><span class="eyebrow">LUYỆN TẬP THEO BÀI</span><h2>Kiểm tra điều em vừa học</h2><p>${practiceCount} câu hỏi · tối đa 5 câu mỗi lượt. Lượt chưa xong sẽ được tiếp tục.</p><p>Đã hoàn tất ${practiceStats.practice_finished} lượt<c:if test="${not empty practiceStats.best_score}"> · Điểm cao nhất <strong><fmt:formatNumber value="${practiceStats.best_score}" maxFractionDigits="1"/>/10</strong></c:if></p><c:choose><c:when test="${practiceCount gt 0}"><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="item_id" value="${item.id}"><input type="hidden" name="scope" value="lesson"><input type="hidden" name="kind" value="MCQ"><button class="btn btn-primary">Luyện tập bài này →</button></form></c:when><c:otherwise><p class="text-secondary">Giáo viên đang chuẩn bị câu hỏi cho bài này.</p></c:otherwise></c:choose></section>
<c:if test="${practiceStats.essay_count gt 0}"><section class="surface mt-4"><h2>Luyện tập tự luận</h2><p>${practiceStats.essay_count} câu tự luận của bài học · mỗi lượt 1 câu.</p><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="item_id" value="${item.id}"><input type="hidden" name="scope" value="lesson"><input type="hidden" name="kind" value="ESSAY"><button class="btn btn-outline-primary">Làm bài tự luận →</button></form></section></c:if><c:if test="${chapter.question_count gt 0}"><section class="surface mt-4"><span class="eyebrow">ÔN TẬP CUỐI CHƯƠNG</span><h2><c:out value="${chapter.title}"/></h2><p>Luyện tổng hợp các bài trong chương · tối đa 10 câu mỗi lượt.</p><form method="post" action="${ctx}/student/start"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="item_id" value="${item.id}"><input type="hidden" name="scope" value="chapter"><input type="hidden" name="kind" value="MCQ"><button class="btn btn-outline-primary">Luyện tập chương →</button></form></section></c:if>
<c:if test="${not empty flashcard}"><section class="surface mt-4 flashcard"><span class="eyebrow">THẺ GHI NHỚ</span><h2>Thử nhớ trước khi lật thẻ</h2><details><summary><c:out value="${flashcard.front}"/></summary><p class="prose"><c:out value="${flashcard.back}"/></p></details><p class="small text-secondary mt-3">Tự trả lời, rồi bấm thẻ để đối chiếu kiến thức.</p></section></c:if><section class="surface mt-4"><h2>Ghi chú của riêng bạn</h2><p class="text-secondary">Chỉ bạn có thể đọc và chỉnh sửa ghi chú này.</p><form method="post" data-busy="Đang lưu…"><%@ include file="../partials/csrf.jspf" %><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="action" value="note"><label class="visually-hidden" for="note">Ghi chú bài học</label><textarea class="form-control" id="note" name="note" rows="6" maxlength="8000" placeholder="Điều quan trọng, câu hỏi cần tìm hiểu, ví dụ dễ nhớ…"><c:out value="${record.note}"/></textarea><button class="btn btn-primary mt-3">Lưu ghi chú</button><span class="small text-secondary ms-2">Tối đa 8.000 ký tự</span></form></section>
<nav class="lesson-navigation" aria-label="Bài trước và bài tiếp theo"><c:if test="${not empty previous}"><a href="${ctx}/student/lesson?id=${previous.id}">← <c:out value="${previous.title}"/></a></c:if><c:if test="${not empty next}"><a href="${ctx}/student/lesson?id=${next.id}"><c:out value="${next.title}"/> →</a></c:if></nav>
</c:otherwise></c:choose></div>
<c:if test="${not preview}"><aside><section class="surface curriculum-panel"><h2>Chương và bài học</h2><div class="progress-caption"><span>Tiến độ của bạn</span><strong>${progress}%</strong></div><progress class="course-progress" value="${progress}" max="100" aria-label="Tiến độ"></progress><div class="curriculum-list"><c:forEach var="i" items="${items}"><a class="${i.id eq item.id ? 'current' : ''}" href="${ctx}/student/lesson?id=${i.id}"><span>${i.completed eq 1 ? '✓' : '○'}</span><span><small><c:out value="${i.section_title}"/></small><c:out value="${i.title}"/><c:if test="${i.bookmarked eq 1}"><small>★ Đã lưu để ôn</small></c:if></span></a></c:forEach></div></section></aside></c:if></div>
<%@ include file="../partials/footer.jspf" %>
