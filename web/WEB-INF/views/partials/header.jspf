<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf-token" content="${fn:escapeXml(sessionScope.csrf)}"><meta name="app-context" content="${pageContext.request.contextPath}">
<title>${landing ? 'Sử Việt • Học Lịch sử lớp 6 theo chương và bài' : 'Sử Việt • Không gian học tập'}</title><c:if test="${landing}"><meta name="description" content="Lộ trình Lịch sử lớp 6 theo chương và bài: bài giảng, video, luyện tập theo bài và ôn tập chương. Tiến độ lưu theo tài khoản, gia sư AI gợi ý từng bước."></c:if><link rel="icon" href="${pageContext.request.contextPath}/assets/favicon.svg" type="image/svg+xml">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/academy.css" rel="stylesheet"></head><body>
<a class="skip-link" href="#main">Đến nội dung chính</a>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:choose><c:when test="${publicPage}">
<header class="public-header"><a class="brand" href="${ctx}/explore"><span class="brand-mark">S</span>Sử Việt<span class="brand-dot">.</span></a><nav aria-label="Điều hướng công khai"><a href="${ctx}/courses">Lộ trình học</a><c:choose><c:when test="${empty sessionScope.user}"><a href="${ctx}/login">Đăng nhập</a><a class="btn btn-primary" href="${ctx}/register">Bắt đầu học</a></c:when><c:otherwise><a class="btn btn-primary" href="${ctx}/home">Không gian của tôi →</a></c:otherwise></c:choose></nav></header><main id="main" class="public-content">
</c:when><c:when test="${not empty sessionScope.user}">
<div class="app-shell"><aside class="sidebar" id="learning-navigation"><a class="brand" href="${ctx}/home"><span class="brand-mark">S</span>Sử Việt<span class="brand-dot">.</span></a>
<div class="workspace-label"><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}">KHÔNG GIAN QUẢN TRỊ</c:when><c:when test="${sessionScope.user.role eq 'TEACHER'}">KHÔNG GIAN GIÁO VIÊN</c:when><c:otherwise>KHÔNG GIAN HỌC TẬP</c:otherwise></c:choose></div>
<nav aria-label="Điều hướng chính" class="side-nav">
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><span class="side-group">QUẢN TRỊ</span><a href="${ctx}/admin/dashboard">◫ <span>Tổng quan</span></a><a href="${ctx}/admin/users">♙ <span>Quản lý người dùng</span></a><a href="${ctx}/admin/catalog?entity=subjects">▦ <span>Môn học</span></a><a href="${ctx}/admin/catalog?entity=lessons">▤ <span>Bài học</span></a><a href="${ctx}/admin/catalog?entity=topics">◇ <span>Chủ đề</span></a><a href="${ctx}/admin/settings">⚙ <span>Cấu hình hệ thống</span></a><span class="side-group">GIÁM SÁT</span><a href="${ctx}/admin/courses">▤ <span>Duyệt chương trình</span></a><a href="${ctx}/admin/results">↗ <span>Dữ liệu bài làm</span></a><a href="${ctx}/admin/progress">◷ <span>Tiến độ học tập</span></a><a href="${ctx}/admin/reports">◷ <span>Thống kê và báo cáo</span></a><span class="side-group">GIÁM SÁT NỘI DUNG</span><a href="${ctx}/admin/catalog?entity=lectures">▣ <span>Kiểm duyệt bài giảng</span></a><a href="${ctx}/admin/catalog?entity=questions">☷ <span>Kiểm duyệt câu hỏi</span></a></c:if>
<c:if test="${sessionScope.user.role eq 'TEACHER'}"><span class="side-group">NỘI DUNG HỌC</span><a href="${ctx}/teacher/courses">▤ <span>Chương trình phụ trách</span></a><a href="${ctx}/teacher/catalog?entity=lectures">▣ <span>Bài giảng</span></a><a href="${ctx}/teacher/catalog?entity=questions">☷ <span>Ngân hàng câu hỏi</span></a><a href="${ctx}/teacher/generate">✦ <span>Soạn câu hỏi với AI</span></a><span class="side-group">LỚP HỌC</span><a href="${ctx}/teacher/students">♙ <span>Học viên</span></a><a href="${ctx}/teacher/progress">◷ <span>Tiến độ học tập</span></a></c:if>
<c:if test="${sessionScope.user.role eq 'STUDENT'}"><a href="${ctx}/student/dashboard">◫ <span>Tổng quan</span></a><a href="${ctx}/courses">📖 <span>Lộ trình học</span></a><a href="${ctx}/student/progress">↗ <span>Tiến độ của em</span></a><a href="${ctx}/student/tutor">✦ <span>Hỏi gia sư AI</span></a><a href="${ctx}/student/history">◷ <span>Lịch sử luyện tập</span></a></c:if>
</nav><div class="side-note"><span class="small-label">MỖI NGÀY MỘT CHÚT</span><p>Hiểu quá khứ.<br>Khám phá hôm nay.</p><span class="ornament">◌ ── ◇ ── ◌</span></div></aside>
<div class="app-main"><header class="topbar"><button class="btn btn-outline-primary mobile-nav-toggle" type="button" data-nav-toggle aria-controls="learning-navigation" aria-expanded="false">☰ Menu</button><span>Học tập / <strong>Sử Việt</strong></span><details class="account-menu"><summary><span class="avatar"><c:out value="${fn:substring(sessionScope.user.name,0,1)}"/></span><span><c:out value="${sessionScope.user.name}"/> ▾</span></summary><div class="account-options"><c:if test="${sessionScope.user.role eq 'STUDENT'}"><a href="${ctx}/student/profile">Hồ sơ học tập</a><a href="${ctx}/student/profile#password">Đổi mật khẩu</a></c:if><form method="post" action="${ctx}/logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="btn btn-sm btn-outline-secondary">Đăng xuất</button></form></div></details></header>
<main id="main" class="main-content">
</c:when><c:otherwise><main id="main" class="auth-main"></c:otherwise></c:choose>
<c:if test="${not empty flash}"><div class="alert alert-success" role="status"><c:out value="${flash}"/></div></c:if>
<c:if test="${not empty error}"><div class="alert alert-danger" role="alert"><c:out value="${error}"/></div></c:if>
