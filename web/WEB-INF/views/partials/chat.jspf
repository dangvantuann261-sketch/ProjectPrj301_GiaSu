<%@ page pageEncoding="UTF-8" %>

<section class="surface chat-panel" id="tutor-chat" data-chat data-item-id="${empty item ? 0 : item.id}" data-answer-id="${empty answer ? 0 : answer.id}" data-autostart="${not empty answer and not empty answer.score and answer.score lt 10 ? 'true' : 'false'}"><div class="chat-heading"><span class="ai-avatar">✦</span><div><h2>Gia sư AI</h2><span class="small text-secondary">Một gợi ý. Một bước tiến.</span></div><button class="btn btn-sm btn-outline-secondary ms-auto" type="button" data-chat-reset>Bắt đầu lại</button></div>
<div class="chat-messages" data-messages aria-live="polite" aria-label="Hội thoại với gia sư"></div><p class="chat-status small" data-chat-status role="status">Em hãy chia sẻ điều mình đang băn khoăn.</p><form data-chat-form><label class="visually-hidden" for="chat-message">Tin nhắn cho gia sư</label><div class="chat-input"><textarea id="chat-message" name="message" rows="2" maxlength="3000" required placeholder="Em đang nghĩ rằng…"><c:out value="${initialMessage}"/></textarea><button type="submit" class="btn btn-primary">Gửi ↑</button></div></form><p class="small text-secondary mt-3 mb-0">AI có thể nhầm. Hãy đối chiếu bài học và trao đổi với giáo viên.</p></section>
